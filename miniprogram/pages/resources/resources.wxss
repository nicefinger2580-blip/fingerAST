.tab-header {
  display: flex;
  border-bottom: 1rpx solid #eef0f4;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-header .tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0 20rpx;
  font-size: 28rpx;
  color: var(--muted);
  position: relative;
}

.tab-header .tab-item.active {
  color: var(--primary);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: var(--primary);
  border-radius: 2rpx;
}

.list-wrap {
  padding-top: 24rpx;
  padding-bottom: 140rpx;
}

.resource-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.res-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.res-blue { background: linear-gradient(135deg, #dbeafe, #eff6ff); }
.res-teal { background: linear-gradient(135deg, #ccfbf1, #ecfeff); }
.res-purple { background: linear-gradient(135deg, #ede9fe, #f5f3ff); }
.res-amber { background: linear-gradient(135deg, #fef3c7, #fff7ed); }

.res-content { flex: 1; min-width: 0; }
.res-title { font-size: 28rpx; font-weight: 500; margin-bottom: 8rpx; }
.res-desc { font-size: 24rpx; line-height: 1.5; }
.res-meta { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.res-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.tag-blue { background: rgba(59,124,255,0.1); color: var(--primary); }
.tag-teal { background: rgba(91,192,190,0.15); color: var(--secondary); }
.tag-purple { background: rgba(99,102,241,0.1); color: #6366f1; }
.tag-amber { background: rgba(245,158,11,0.1); color: #d97706; }

.arrow { font-size: 32rpx; margin-top: 8rpx; }
