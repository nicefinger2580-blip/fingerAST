.login-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.login-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 420rpx;
  background: linear-gradient(160deg, #3B7CFF 0%, #5BC0BE 100%);
  border-radius: 0 0 48rpx 48rpx;
}

.login-body {
  position: relative;
  z-index: 1;
  padding: 64rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.brand-block {
  text-align: center;
  color: #fff;
  margin-bottom: 48rpx;
}

.brand-logo {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.brand-name {
  font-size: 44rpx;
  font-weight: 700;
}

.brand-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

.profile-preview-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.preview-label {
  font-size: 24rpx;
  margin-bottom: 8rpx;
  text-align: center;
}

.auth-field {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 16rpx 0;
}

.auth-divider {
  height: 1rpx;
  background: var(--border, rgba(0, 0, 0, 0.06));
  margin: 0 8rpx;
}

.field-label {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  color: var(--ink);
}

.field-body {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.field-fill {
  flex: 1;
  min-width: 0;
}

.avatar-wrap {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.avatar-picker {
  width: 100% !important;
  height: 100% !important;
  min-width: 0 !important;
  max-width: 88rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent;
  border: none;
  line-height: 1;
  overflow: hidden;
  border-radius: 44rpx;
}
.avatar-picker::after { border: none; }

.preview-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  border: 2rpx solid rgba(59, 124, 255, 0.15);
  display: block;
}

.preview-avatar-empty {
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--muted);
}

.nickname-input {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  text-align: right;
  height: 72rpx;
  line-height: 72rpx;
}

.arrow {
  font-size: 36rpx;
  flex-shrink: 0;
  line-height: 1;
}

.auth-card {
  padding: 40rpx 32rpx;
}

.auth-tip {
  font-size: 26rpx;
  line-height: 1.7;
  text-align: center;
  margin-bottom: 40rpx;
}

.wx-auth-btn {
  width: 100% !important;
  height: 96rpx !important;
  line-height: 96rpx !important;
  background: #07c160 !important;
  color: #fff !important;
  font-size: 32rpx !important;
  font-weight: 500;
  border-radius: 48rpx !important;
  border: none !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.wx-auth-btn-disabled {
  opacity: 0.55;
}

.wx-auth-btn::after { border: none; }

.wx-icon { font-size: 40rpx; }

.cancel-link {
  margin-top: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--muted);
}
