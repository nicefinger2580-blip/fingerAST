.follow-item {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.follow-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.follow-avatar,
.follow-avatar-fallback {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  flex-shrink: 0;
}

.follow-avatar-fallback {
  background: linear-gradient(135deg, #60a5fa, #2563eb);
  color: #fff;
  font-size: 32rpx;
  line-height: 88rpx;
  text-align: center;
}

.follow-body {
  flex: 1;
  min-width: 0;
}

.follow-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.follow-date {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.follow-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: var(--surface);
  color: var(--muted);
}

.action-btn.primary {
  background: rgba(59, 124, 255, 0.1);
  color: var(--primary);
}

.action-btn.danger {
  background: rgba(255, 77, 79, 0.08);
  color: var(--danger);
}
