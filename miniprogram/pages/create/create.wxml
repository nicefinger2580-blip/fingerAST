<view class="page page-pad">
  <!-- 输入态 -->
  <block wx:if="{{status === 'input'}}">
    <view class="card guide-card mt-4">
      <view class="guide-row">
        <view class="guide-icon">💡</view>
        <view>
          <view class="guide-title">AI 智能生成论文结构</view>
          <view class="text-muted guide-desc">输入论文主题或关键词，AI 将为你生成结构模板</view>
        </view>
      </view>
    </view>

    <view class="mt-4">
      <view class="label">论文提示词</view>
      <view class="card input-card">
        <textarea
          class="prompt-input"
          placeholder="请输入论文题目、关键词或研究方向..."
          maxlength="{{maxLen}}"
          value="{{prompt}}"
          bindinput="onPromptInput"
          auto-height
          show-confirm-bar="{{false}}"
        />
        <text class="char-count text-faint">{{charCount}}/{{maxLen}}</text>
      </view>
    </view>

    <view class="mt-3">
      <view class="text-muted preset-label">示例提示词</view>
      <view class="preset-row">
        <view
          wx:for="{{presets}}"
          wx:key="*this"
          class="preset-tag"
          data-key="{{item}}"
          bindtap="onPresetTap"
        >{{item}}</view>
      </view>
    </view>

    <view class="mt-5">
      <button class="btn-primary" bindtap="onGenerate">开始生成</button>
      <view class="cost-tip text-faint">本次生成将消耗 {{costGenerate}} 积分</view>
    </view>

    <view class="empty-state">
      <view class="empty-icon">📄</view>
      <text class="text-muted">输入提示词后点击生成</text>
      <text class="text-faint empty-sub">AI 将为你构建完整论文大纲</text>
    </view>
  </block>

  <!-- 生成中 -->
  <block wx:elif="{{status === 'loading'}}">
    <view class="card prompt-preview mt-4">
      <text class="text-muted line-clamp-2">{{prompt}}</text>
    </view>
    <button class="btn-primary mt-3" disabled>生成中...</button>
    <view class="cost-tip text-faint">本次生成将消耗 {{costGenerate}} 积分</view>
    <view class="loading-wrap">
      <view class="loading-ring"></view>
      <text class="loading-title">AI 正在构思中...</text>
      <text class="text-faint">预计等待 3~8 秒</text>
      <text class="cancel-link text-muted" bindtap="onCancelGenerate">取消生成</text>
    </view>
  </block>

  <!-- 结果态 -->
  <block wx:else>
    <view class="result-head mt-3">
      <view>
        <view class="result-title">生成结果</view>
        <view class="text-faint result-sub">共 {{outline.length}} 个章节 · 可勾选导出</view>
      </view>
      <view class="result-actions">
        <text class="text-primary action-btn" bindtap="onRegenerate">↻ 重新生成</text>
        <text class="text-muted action-btn" bindtap="onToggleExpand">{{expandAll ? '收起全部' : '展开全部'}}</text>
      </view>
    </view>

    <checkbox-group class="card outline-card mt-3" bindchange="onCheckChange">
      <label wx:for="{{outline}}" wx:key="id" class="outline-item level-{{item.level}}" wx:if="{{expandAll || item.level <= 1}}">
        <checkbox value="{{item.id}}" checked="{{item.checked}}" color="#3B7CFF" />
        <text class="{{item.level === 1 ? 'outline-l1' : 'outline-l2'}}">{{item.title}}</text>
      </label>
    </checkbox-group>

    <view class="bottom-spacer"></view>
    <view class="bottom-bar">
      <button class="btn-secondary" bindtap="onShareExhibit">分享到展览</button>
      <button class="btn-primary" bindtap="onExportDocx">保存为 docx（{{costExport}}积分）</button>
    </view>
  </block>
</view>
