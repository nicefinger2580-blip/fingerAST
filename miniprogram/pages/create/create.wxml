<view class="page page-pad">
  <!-- 输入态 -->
  <block wx:if="{{status === 'input'}}">
    <view class="card guide-card mt-4">
      <view class="guide-row">
        <view class="guide-icon">💡</view>
        <view>
          <view class="guide-title">AI 智能生成论文全文</view>
          <view class="text-muted guide-desc">输入题目与格式规范，AI 将严格按你的要求生成完整论文</view>
        </view>
      </view>
    </view>

    <view class="mt-4">
      <view class="label">论文提示词</view>
      <view class="text-faint hint-text">{{promptHint}}</view>
      <view class="card input-card">
        <textarea
          class="prompt-input"
          placeholder="示例：&#10;【题目】基于深度学习的…&#10;【格式】硕士论文；摘要300字；正文8000字；GB/T 7714引用；章节：摘要/引言/…/参考文献"
          maxlength="{{maxLen}}"
          value="{{prompt}}"
          bindinput="onPromptInput"
          auto-height
          show-confirm-bar="{{false}}"
        />
        <text class="char-count text-faint">{{charCount}}/{{maxLen}}</text>
      </view>
    </view>

    <view class="mt-3">
      <view class="text-muted preset-label">示例提示词（含格式规范）</view>
      <view class="preset-row">
        <view
          wx:for="{{presets}}"
          wx:key="*this"
          class="preset-tag"
          data-key="{{item}}"
          bindtap="onPresetTap"
        >{{item}}</view>
      </view>
    </view>

    <view class="mt-5">
      <button class="btn-primary" bindtap="onGenerate">开始生成</button>
      <view class="cost-tip text-faint">本次生成将消耗 {{costGenerate}} 积分</view>
    </view>

    <view class="empty-state">
      <view class="empty-icon">📄</view>
      <text class="text-muted">输入提示词后点击生成</text>
      <text class="text-faint empty-sub">AI 将生成含完整正文的学术论文</text>
    </view>
  </block>

  <!-- 生成中 -->
  <block wx:elif="{{status === 'loading'}}">
    <view class="card prompt-preview mt-4">
      <text class="text-muted line-clamp-3">{{prompt}}</text>
    </view>
    <button class="btn-primary mt-3" disabled>生成中...</button>
    <view class="cost-tip text-faint">本次生成将消耗 {{costGenerate}} 积分</view>
    <view class="loading-wrap">
      <view class="loading-ring"></view>
      <text class="loading-title">AI 正在撰写论文...</text>
      <text class="text-faint">全文生成约需 30~90 秒，请耐心等待</text>
      <text class="cancel-link text-muted" bindtap="onCancelGenerate">取消生成</text>
    </view>
  </block>

  <!-- 结果态 -->
  <block wx:else>
    <view class="result-head mt-3">
      <view>
        <view class="result-title">{{paperTitle || '生成结果'}}</view>
        <view class="text-faint result-sub">共 {{outline.length}} 个章节 · 可勾选导出</view>
      </view>
      <view class="result-actions">
        <text class="text-primary action-btn" bindtap="onRegenerate">↻ 重新生成</text>
        <text class="text-muted action-btn" bindtap="onToggleExpand">{{expandAll ? '收起小节' : '展开全部'}}</text>
      </view>
    </view>

    <checkbox-group class="paper-list mt-3" bindchange="onCheckChange">
      <label
        wx:for="{{outline}}"
        wx:key="id"
        class="card paper-section level-{{item.level}}"
        wx:if="{{expandAll || item.level <= 1}}"
      >
        <view class="section-head">
          <checkbox value="{{item.id}}" checked="{{item.checked}}" color="#3B7CFF" />
          <text class="section-title">{{item.title}}</text>
        </view>
        <text class="section-content text-muted">{{item.content}}</text>
      </label>
    </checkbox-group>

    <view class="bottom-spacer"></view>
    <view class="bottom-bar">
      <button class="btn-secondary" bindtap="onShareExhibit" disabled="{{shared}}">
        {{shared ? '已分享到展览' : '分享到展览'}}
      </button>
      <button class="btn-primary" bindtap="onExportDocx">保存为 docx（{{costExport}}积分）</button>
    </view>
  </block>
</view>
