.search-section {
  padding-top: 24rpx;
  padding-bottom: 16rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--surface);
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 72rpx;
  font-size: 28rpx;
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.5;
}

.filter-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tip-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(59, 124, 255, 0.08);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin: 24rpx 0;
}

.tip-icon {
  color: var(--primary);
  font-size: 28rpx;
}

.tip-text {
  font-size: 24rpx;
}

.waterfall {
  display: flex;
  gap: 24rpx;
  padding-bottom: 180rpx;
}

.waterfall-col {
  flex: 1;
  min-width: 0;
}

.template-card {
  overflow: hidden;
  margin-bottom: 24rpx;
}

.card-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}

.cover-blue { background: linear-gradient(135deg, #dbeafe, #eff6ff); }
.cover-teal { background: linear-gradient(135deg, #ccfbf1, #ecfeff); min-height: 280rpx; }
.cover-indigo { background: linear-gradient(135deg, #e0e7ff, #f5f3ff); min-height: 240rpx; }
.cover-amber { background: linear-gradient(135deg, #fef3c7, #fff7ed); }

.cover-emoji {
  font-size: 64rpx;
  opacity: 0.8;
}

.card-body {
  padding: 20rpx;
}

.card-title {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink);
}

.card-desc {
  font-size: 20rpx;
  line-height: 1.5;
  margin-top: 8rpx;
  max-height: calc(20rpx * 1.5 * 3);
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  font-size: 20rpx;
}

.meta-author {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 8rpx;
}
