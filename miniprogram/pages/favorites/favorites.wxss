.fav-item {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.fav-cover {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.cover-blue { background: linear-gradient(135deg, #dbeafe, #eff6ff); }
.cover-teal { background: linear-gradient(135deg, #ccfbf1, #ecfeff); }
.cover-indigo { background: linear-gradient(135deg, #e0e7ff, #f5f3ff); }
.cover-amber { background: linear-gradient(135deg, #fef3c7, #fff7ed); }

.fav-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.fav-meta {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.fav-desc {
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}

.fav-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: var(--surface);
  color: var(--muted);
}

.action-btn.primary {
  background: rgba(59, 124, 255, 0.1);
  color: var(--primary);
}

.action-btn.danger {
  background: rgba(255, 77, 79, 0.08);
  color: var(--danger);
}
