.stats-card { padding: 40rpx; text-align: center; }
.stats-num { display: flex; align-items: flex-end; justify-content: center; gap: 8rpx; margin: 16rpx 0; }
.num { font-size: 96rpx; font-weight: 700; color: var(--secondary); line-height: 1; }
.unit { font-size: 28rpx; color: var(--muted); margin-bottom: 12rpx; }
.stats-tip { font-size: 24rpx; }

.calendar-card { padding: 32rpx; }
.cal-head { text-align: center; margin-bottom: 24rpx; }
.cal-title { font-size: 28rpx; font-weight: 600; }
.week-row { display: grid; grid-template-columns: repeat(7, 1fr); margin-bottom: 8rpx; }
.week-cell { text-align: center; font-size: 20rpx; color: var(--faint); padding: 8rpx 0; }
.day-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; }
.day-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--muted);
  border-radius: 50%;
  position: relative;
}
.day-cell.empty { visibility: hidden; }
.day-cell.signed { background: rgba(91,192,190,0.2); color: var(--ink); }
.day-cell.today { background: var(--primary); color: #fff; font-weight: 600; }
.signed-dot {
  position: absolute;
  bottom: 6rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--secondary);
}
.day-cell.today .signed-dot { background: #fff; }

.mt-4 { margin-top: 32rpx; }
.mt-5 { margin-top: 40rpx; }

.toast-success {
  text-align: center;
  margin-top: 24rpx;
  display: inline-block;
  width: 100%;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0,0,0,0.75);
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.rules { padding: 32rpx; }
.rules-title { font-size: 28rpx; font-weight: 500; margin-bottom: 16rpx; }
.rule-line { font-size: 24rpx; line-height: 2; }
