.mt-3 { margin-top: 24rpx; }
.preview-card { overflow: hidden; }
.preview-inner {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  text-align: center;
}
.cover-blue { background: linear-gradient(135deg, #dbeafe, #fff); }
.cover-teal { background: linear-gradient(135deg, #ccfbf1, #fff); }
.cover-indigo { background: linear-gradient(135deg, #e0e7ff, #fff); }
.cover-amber { background: linear-gradient(135deg, #fef3c7, #fff); }
.preview-emoji { font-size: 80rpx; margin-bottom: 16rpx; }
.preview-title { font-size: 24rpx; color: var(--muted); line-height: 1.5; }

.author-card { padding: 32rpx; }
.author-row { display: flex; justify-content: space-between; align-items: flex-start; }
.author-left { display: flex; gap: 16rpx; align-items: center; }
.author-avatar,
.author-avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
}
.author-avatar {
  background: #22c55e;
  color: #fff;
  text-align: center;
  line-height: 64rpx;
  font-size: 24rpx;
}
.author-name { font-size: 28rpx; font-weight: 500; }
.author-date { font-size: 20rpx; margin-top: 4rpx; }
.author-actions { display: flex; gap: 32rpx; }
.action-col { display: flex; flex-direction: column; align-items: center; font-size: 32rpx; }
.action-num { font-size: 20rpx; margin-top: 4rpx; }
.liked { color: var(--danger); }
.desc {
  font-size: 28rpx;
  line-height: 1.6;
  margin-top: 24rpx;
  max-height: calc(28rpx * 1.6 * 3);
}

.outline-section, .comments { padding: 32rpx; }
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.section-title { font-size: 28rpx; font-weight: 600; }
.expand-btn {
  font-size: 24rpx;
  flex-shrink: 0;
  padding: 8rpx 0 8rpx 24rpx;
}
.body-fold-hint {
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3f4f6;
}
.outline-line { font-size: 28rpx; color: var(--muted); padding: 8rpx 0; }
.level-1 { font-weight: 600; color: var(--ink); }
.level-2 { padding-left: 32rpx; }
.paper-content {
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.75;
  white-space: pre-wrap;
  padding: 8rpx 0 24rpx;
}
.paper-content.level-2 { padding-left: 32rpx; }
.paper-content.level-3 { padding-left: 64rpx; }

.comment-item { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.comment-avatar,
.comment-avatar-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}
.comment-avatar {
  background: #60a5fa;
  color: #fff;
  text-align: center;
  line-height: 56rpx;
  font-size: 20rpx;
}
.comment-head { font-size: 24rpx; }
.comment-author { font-weight: 500; }
.comment-date { margin-left: 12rpx; }
.comment-text { font-size: 24rpx; margin-top: 4rpx; line-height: 1.5; }

.comment-empty {
  font-size: 24rpx;
  padding: 16rpx 0 8rpx;
}

.page-with-bottom-bar {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.page-with-comment-bar {
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(136rpx + env(safe-area-inset-bottom));
  padding: 16rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid #eef0f4;
  display: flex;
  gap: 16rpx;
  align-items: center;
  z-index: 95;
  box-sizing: border-box;
}

.comment-form {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f3f4f6;
}
.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--surface);
  border-radius: 36rpx;
  font-size: 26rpx;
}
.comment-send {
  background: var(--primary) !important;
  color: #fff !important;
  border: none !important;
  margin: 0 !important;
  padding: 0 28rpx !important;
  line-height: 64rpx !important;
  height: 64rpx !important;
  border-radius: 32rpx !important;
}


.detail-bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eef0f4;
  display: flex;
  gap: 24rpx;
  z-index: 90;
}
.detail-bottom .btn-primary,
.detail-bottom .btn-secondary { flex: 1; font-size: 28rpx; }
