<view class="page page-pad" wx:if="{{user}}">
  <view wx:if="{{loading}}" class="empty-state mt-4">
    <text class="text-muted">加载中...</text>
  </view>

  <block wx:else>
  <view class="points-card mt-4">
    <view class="pc-top">
      <view class="pc-main">
        <view class="text-faint pc-label">当前积分余额</view>
        <view class="pc-balance">
          <text class="pc-num">{{user.points}}</text>
          <text class="pc-unit">积分</text>
        </view>
      </view>
      <view class="recharge-btn" bindtap="onOpenRecharge">充值</view>
    </view>
    <view class="pc-stats">
      <view>
        <view class="pc-stat-num">+{{totalEarn}}</view>
        <view class="text-faint pc-stat-label">累计获取</view>
      </view>
      <view>
        <view class="pc-stat-num">-{{totalSpend}}</view>
        <view class="text-faint pc-stat-label">累计消耗</view>
      </view>
    </view>
  </view>

  <view class="tab-switch mt-4">
    <view class="switch-item {{tab === 0 ? 'active' : ''}}" data-index="0" bindtap="onTabTap">获取记录</view>
    <view class="switch-item {{tab === 1 ? 'active' : ''}}" data-index="1" bindtap="onTabTap">消耗记录</view>
  </view>

  <view class="record-list">
    <view wx:for="{{tab === 0 ? earnList : spendList}}" wx:key="id" class="card record-item">
      <view class="record-left">
        <view class="record-icon">{{tab === 0 ? '📅' : '📄'}}</view>
        <view>
          <view class="record-title">{{item.title}}</view>
          <view class="text-faint record-time">{{item.time}}</view>
        </view>
      </view>
      <text class="record-amount {{tab === 0 ? 'earn' : 'spend'}}">
        {{tab === 0 ? '+' : '-'}}{{item.amount}}
      </text>
    </view>
    <view wx:if="{{tab === 1 && spendList.length === 0}}" class="empty-state">
      <text class="text-muted">暂无消耗记录</text>
    </view>
    <view wx:if="{{tab === 0 && earnList.length === 0}}" class="empty-state">
      <text class="text-muted">暂无获取记录</text>
    </view>
  </view>
  </block>
</view>

<view wx:if="{{showRecharge}}" class="recharge-mask" bindtap="onCloseRecharge">
  <view class="recharge-sheet" catchtap="noop">
    <view class="sheet-head">
      <text class="sheet-title">积分充值</text>
      <text class="sheet-close" bindtap="onCloseRecharge">✕</text>
    </view>
    <view class="sheet-tip text-faint">支付成功后积分自动到账</view>
    <view
      wx:for="{{packs}}"
      wx:key="id"
      class="pack-item {{paying ? 'pack-disabled' : ''}}"
      data-id="{{item.id}}"
      bindtap="onSelectPack"
    >
      <view class="pack-left">
        <view class="pack-points">{{item.points}} 积分</view>
        <view class="text-faint pack-label">{{item.label}}</view>
      </view>
      <view class="pack-price">¥{{item.priceYuan}}</view>
    </view>
    <view class="sheet-note text-faint">充值积分不可退款，请确认后支付</view>
  </view>
</view>
