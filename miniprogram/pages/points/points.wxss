.points-card {
  background: linear-gradient(135deg, #3B7CFF, #2563eb);
  border-radius: 24rpx;
  padding: 40rpx;
  color: #fff;
}
.pc-label { font-size: 24rpx; opacity: 0.85; }
.pc-balance { display: flex; align-items: flex-end; gap: 8rpx; margin: 16rpx 0 32rpx; }
.pc-num { font-size: 80rpx; font-weight: 700; line-height: 1; }
.pc-unit { font-size: 28rpx; opacity: 0.85; margin-bottom: 12rpx; }
.pc-stats {
  display: flex;
  gap: 64rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}
.pc-stat-num { font-size: 36rpx; font-weight: 600; }
.pc-stat-label { font-size: 20rpx; opacity: 0.75; margin-top: 4rpx; }

.tab-switch {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.switch-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  border-radius: 12rpx;
}
.switch-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: 500;
}

.record-list { padding: 24rpx 0; }
.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}
.record-left { display: flex; gap: 24rpx; align-items: center; }
.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(91,192,190,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.record-title { font-size: 28rpx; }
.record-time { font-size: 20rpx; margin-top: 4rpx; }
.record-amount { font-size: 28rpx; font-weight: 600; }
.record-amount.earn { color: var(--success); }
.record-amount.spend { color: var(--danger); }

.mt-4 { margin-top: 32rpx; }
