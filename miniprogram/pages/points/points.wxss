.points-card {
  background: linear-gradient(135deg, #3B7CFF, #2563eb);
  border-radius: 24rpx;
  padding: 40rpx;
  color: #fff;
}
.pc-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}
.pc-main { flex: 1; min-width: 0; }
.pc-label { font-size: 24rpx; opacity: 0.85; }
.pc-balance { display: flex; align-items: flex-end; gap: 8rpx; margin: 16rpx 0 0; }
.recharge-btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 28rpx;
}
.pc-num { font-size: 80rpx; font-weight: 700; line-height: 1; }
.pc-unit { font-size: 28rpx; opacity: 0.85; margin-bottom: 12rpx; }
.pc-stats {
  display: flex;
  gap: 64rpx;
  padding-top: 32rpx;
  margin-top: 32rpx;
  border-top: 1rpx solid rgba(255,255,255,0.2);
}
.pc-stat-num { font-size: 36rpx; font-weight: 600; }
.pc-stat-label { font-size: 20rpx; opacity: 0.75; margin-top: 4rpx; }

.tab-switch {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.06);
}
.switch-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--muted);
  border-radius: 12rpx;
}
.switch-item.active {
  background: var(--primary);
  color: #fff;
  font-weight: 500;
}

.record-list { padding: 24rpx 0; }
.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}
.record-left { display: flex; gap: 24rpx; align-items: center; }
.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(91,192,190,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.record-title { font-size: 28rpx; }
.record-time { font-size: 20rpx; margin-top: 4rpx; }
.record-amount { font-size: 28rpx; font-weight: 600; }
.record-amount.earn { color: var(--success); }
.record-amount.spend { color: var(--danger); }

.mt-4 { margin-top: 32rpx; }

.recharge-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.recharge-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}
.sheet-close {
  font-size: 32rpx;
  color: var(--faint);
  padding: 8rpx;
}
.sheet-tip {
  font-size: 24rpx;
  margin-bottom: 24rpx;
}
.pack-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: var(--surface);
  border: 2rpx solid transparent;
}
.pack-item:active {
  border-color: var(--primary);
  background: rgba(59, 124, 255, 0.06);
}
.pack-disabled {
  opacity: 0.6;
  pointer-events: none;
}
.pack-points {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}
.pack-label {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.pack-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}
.sheet-note {
  font-size: 22rpx;
  text-align: center;
  margin-top: 8rpx;
}
