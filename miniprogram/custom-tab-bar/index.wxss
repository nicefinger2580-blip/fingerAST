.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #eef0f4;
  display: flex;
  z-index: 9999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 10rpx;
}

.tab-text {
  font-size: 20rpx;
  color: #B0BEC5;
  margin-top: 4rpx;
}

.tab-bar-item.active .tab-text {
  color: #3B7CFF;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.tab-icon-home::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: 20rpx;
  width: 32rpx;
  height: 16rpx;
  border: 3rpx solid #B0BEC5;
  border-top: none;
}

.tab-icon-home::after {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #B0BEC5;
  border-bottom: none;
  transform: rotate(45deg);
}

.tab-icon-create::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #B0BEC5;
  border-radius: 4rpx;
}

.tab-icon-create::after {
  content: '';
  position: absolute;
  left: 24rpx;
  top: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #B0BEC5;
  border-right: 3rpx solid #B0BEC5;
}

.tab-icon-resource::before {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  width: 24rpx;
  height: 30rpx;
  border: 3rpx solid #B0BEC5;
  border-radius: 4rpx;
}

.tab-icon-mine::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 6rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #B0BEC5;
  border-radius: 50%;
}

.tab-icon-mine::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 26rpx;
  width: 28rpx;
  height: 14rpx;
  border: 3rpx solid #B0BEC5;
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
}

.tab-icon.active::before,
.tab-icon.active::after {
  border-color: #3B7CFF;
}

.tab-icon-home.active::before,
.tab-icon-home.active::after {
  background: transparent;
}

.tab-icon-home.active::before {
  background: #3B7CFF;
  border-color: #3B7CFF;
}

.tab-icon-create.active::before {
  background: #3B7CFF;
  border-color: #3B7CFF;
}

.tab-icon-resource.active::before {
  background: #3B7CFF;
  border-color: #3B7CFF;
}

.tab-icon-mine.active::before {
  background: #3B7CFF;
  border-color: #3B7CFF;
}
